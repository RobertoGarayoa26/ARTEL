# ============================================================
#  ARTEL WEB — Variables de entorno
#  Copia este archivo como ".env.local" y rellena los valores.
# ============================================================

# --- Envío de leads por correo (Resend) ---
# 1. Crea cuenta gratis en https://resend.com
# 2. Verifica tu dominio cr-artel.com
# 3. Genera un API key y pégala aquí.
RESEND_API_KEY=

# Correo que RECIBE los leads
LEAD_TO_EMAIL=aflores@cr-artel.com
# Remitente (debe ser de un dominio verificado en Resend)
LEAD_FROM_EMAIL=leads@cr-artel.com

# --- Analítica (opcional pero recomendado) ---
# ID de Google Analytics 4 (formato G-XXXXXXX)
NEXT_PUBLIC_GA4_ID=
# ID de Google Tag Manager (formato GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# --- Contacto (se usa en botones y schema) ---
# WhatsApp en formato internacional SIN "+", ej. 5215512345678
NEXT_PUBLIC_WHATSAPP=5215500000000
NEXT_PUBLIC_SITE_URL=https://www.cr-artel.com
